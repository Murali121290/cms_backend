{
  "options": {
    "tsp_mode": "pi",
    "css_replace": [ ["#ffffff", "#0d2950"] ],
    "list_markers": {
      "BulletList1": "\u2022", "BulletList1_first": "\u2022", "BulletList1_last": "\u2022",
      "UL-FL1_first": "\u2022", "UL-FL1_last": "\u2022",
      "TB-BulletList1": "\u2022", "TB-BulletList2": "\u2013"
    },
    "list_numbers": [ "NumberList1", "NumberList1_first", "NumberList1_last" ]
  },

  "xml_to_xhtml": {
    "book":            { "target_tag": "div" },
    "book-body":       { "target_tag": "div" },
    "book-part":       { "target_tag": "div" },
    "book-part-meta":  { "target_tag": "div" },
    "title-group":     { "target_tag": "div" },
    "body":            { "target_tag": "div" },
    "disp-quote":      { "target_tag": "div" },
    "sec":             { "target_tag": "div" },
    "section":         { "target_tag": "div" },
    "abstract":        { "target_tag": "div" },
    "kwd-group":       { "target_tag": "div" },
    "boxed-text":      { "target_tag": "div" },
    "contrib-group":   { "target_tag": "div" },
    "ref-list":        { "target_tag": "div" },
    "ref":             { "target_tag": "div", "class": "ref" },
    "table-wrap":      { "target_tag": "div" },
    "table-wrap-foot": { "target_tag": "div" },
    "fn":              { "target_tag": "div" },
    "fig":             { "target_tag": "div" },
    "caption":         { "target_tag": "div", "class": "caption" },
    
    "title":           { "target_tag": "h2", "class": "title" },
    "p":               { "target_tag": "p" },
    "para":            { "target_tag": "p" },
    "attrib":          { "target_tag": "p", "class": "attrib" },
    "kwd":             { "target_tag": "p", "class": "kwd" },
    "mixed-citation":  { "target_tag": "p", "class": "mixed-citation" },

    "list": [
      { "xpath": "@list-type='bullet'", "target_tag": "ul" },
      { "xpath": "@list-type='order'",  "target_tag": "ol" },
      { "default": true,                "target_tag": "ul" }
    ],
    "list-item":       { "target_tag": "li" },

    "italic":          { "target_tag": "i" },
    "bold":            { "target_tag": "b" },
    "label":           { "target_tag": "span", "class": "label" },
    "graphic":         { "target_tag": "span", "class": "graphic" },
    "onlyforpdf":      { "target_tag": "span", "class": "onlyforpdf" },
    "xref":            { "target_tag": "span", "class": "xref" },

    "person-group":    { "target_tag": "span", "class": "person-group" },
    "chapter-title":   { "target_tag": "span", "class": "chapter-title" },
    "collab":          { "target_tag": "span", "class": "collab" },
    "string-name":     { "target_tag": "span", "class": "string-name" },
    "surname":         { "target_tag": "span", "class": "surname" },
    "given-names":     { "target_tag": "span", "class": "given-names" },
    "year":            { "target_tag": "span", "class": "year" },
    "article-title":   { "target_tag": "span", "class": "article-title" },
    "source":          { "target_tag": "span", "class": "source" },
    "volume":          { "target_tag": "span", "class": "volume" },
    "issue":           { "target_tag": "span", "class": "issue" },
    "fpage":           { "target_tag": "span", "class": "fpage" },
    "lpage":           { "target_tag": "span", "class": "lpage" },
    "uri":             { "target_tag": "a", "class": "ext-link" },
    "ext-link":        { "target_tag": "a", "class": "ext-link" }
  },

  "xhtml_to_xml": {
    "section": { "target_tag": "sec" },
    "div":     { "target_tag": "sec" },
    "h2":      { "target_tag": "title" },
    "p":       { "target_tag": "p" },
    "ul":      { "target_tag": "list" },
    "ol":      { "target_tag": "list" },
    "li":      { "target_tag": "list-item" },
    "a":       { "target_tag": "ext-link" },
    "i":       { "target_tag": "italic", "aid_cstyle": "italic" },
    "em":      { "target_tag": "italic", "aid_cstyle": "italic" },
    "b":       { "target_tag": "bold",   "aid_cstyle": "bold" },
    "strong":  { "target_tag": "bold",   "aid_cstyle": "bold" },
    "span":    { "unwrap": true },
    "br":      { "unwrap": true }
  }
}

{
 "about": "Unit registry shared by the CE unit rules (R1 SI units, R2 symbol formatting, R3 spacing, R9 micro, R10 exponents, R28 conversion flags). Symbols are case-sensitive. 'prefixes' lists the SI prefixes allowed with that unit; keep it short to avoid false matches (for example 'pm' is not picometre here because it reads as a time).",
 "prefixes": {
  "Q": 1e30, "R": 1e27, "Y": 1e24, "Z": 1e21, "E": 1e18, "P": 1e15, "T": 1e12, "G": 1e9, "M": 1e6, "k": 1e3, "h": 1e2, "da": 1e1,
  "d": 1e-1, "c": 1e-2, "m": 1e-3, "μ": 1e-6, "n": 1e-9, "p": 1e-12, "f": 1e-15, "a": 1e-18, "z": 1e-21, "y": 1e-24, "r": 1e-27, "q": 1e-30
 },
 "micro_lookalikes": ["u", "µ"],
 "units": [
  {"symbol": "m", "name": "metre", "quantity": "length", "kind": "base", "prefixes": ["k", "c", "d", "m", "μ", "n"]},
  {"symbol": "g", "name": "gram", "quantity": "mass", "kind": "base", "prefixes": ["k", "m", "μ", "n", "p"]},

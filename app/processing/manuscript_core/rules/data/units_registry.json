  {"symbol": "A", "name": "ampere", "quantity": "electric current", "kind": "base", "prefixes": ["k", "m", "μ", "n"]},
  {"symbol": "K", "name": "kelvin", "quantity": "temperature", "kind": "base", "prefixes": ["m"], "ambiguous": true},
  {"symbol": "mol", "name": "mole", "quantity": "amount of substance", "kind": "base", "prefixes": ["k", "m", "μ", "n", "p", "f"]},
  {"symbol": "cd", "name": "candela", "quantity": "luminous intensity", "kind": "base", "prefixes": []},

  {"symbol": "N", "name": "newton", "quantity": "force", "kind": "derived", "prefixes": ["k", "m"]},
  {"symbol": "Pa", "name": "pascal", "quantity": "pressure", "kind": "derived", "prefixes": ["k", "M", "G", "h", "m"]},
  {"symbol": "J", "name": "joule", "quantity": "energy", "kind": "derived", "prefixes": ["k", "M", "m"]},
  {"symbol": "W", "name": "watt", "quantity": "power", "kind": "derived", "prefixes": ["k", "M", "G", "m", "μ"]},
  {"symbol": "C", "name": "coulomb", "quantity": "electric charge", "kind": "derived", "prefixes": ["m", "μ", "n"], "ambiguous": true},
  {"symbol": "V", "name": "volt", "quantity": "electric potential", "kind": "derived", "prefixes": ["k", "m", "μ"]},
  {"symbol": "F", "name": "farad", "quantity": "capacitance", "kind": "derived", "prefixes": ["m", "μ", "n", "p"], "ambiguous": true},
  {"symbol": "Ω", "name": "ohm", "quantity": "resistance", "kind": "derived", "prefixes": ["k", "M", "m"]},
  {"symbol": "S", "name": "siemens", "quantity": "conductance", "kind": "derived", "prefixes": ["m", "μ"], "ambiguous": true},
  {"symbol": "Wb", "name": "weber", "quantity": "magnetic flux", "kind": "derived", "prefixes": ["m"]},
  {"symbol": "T", "name": "tesla", "quantity": "magnetic flux density", "kind": "derived", "prefixes": ["m", "μ", "n"]},
  {"symbol": "H", "name": "henry", "quantity": "inductance", "kind": "derived", "prefixes": ["m", "μ", "n"], "ambiguous": true},
  {"symbol": "Hz", "name": "hertz", "quantity": "frequency", "kind": "derived", "prefixes": ["k", "M", "G", "T"]},
  {"symbol": "rad", "name": "radian", "quantity": "plane angle", "kind": "derived", "prefixes": ["m"], "ambiguous": true},
  {"symbol": "sr", "name": "steradian", "quantity": "solid angle", "kind": "derived", "prefixes": []},
  {"symbol": "lm", "name": "lumen", "quantity": "luminous flux", "kind": "derived", "prefixes": []},
  {"symbol": "lx", "name": "lux", "quantity": "illuminance", "kind": "derived", "prefixes": []},
  {"symbol": "Bq", "name": "becquerel", "quantity": "radioactivity", "kind": "derived", "prefixes": ["k", "M", "G", "T"]},
  {"symbol": "Gy", "name": "gray", "quantity": "absorbed dose", "kind": "derived", "prefixes": ["c", "m", "μ"]},
  {"symbol": "Sv", "name": "sievert", "quantity": "equivalent dose", "kind": "derived", "prefixes": ["m", "μ"]},
  {"symbol": "kat", "name": "katal", "quantity": "catalytic activity", "kind": "derived", "prefixes": ["μ", "n"]},

  {"symbol": "min", "name": "minute", "quantity": "time", "kind": "accepted", "prefixes": []},
  {"symbol": "h", "name": "hour", "quantity": "time", "kind": "accepted", "prefixes": []},
  {"symbol": "d", "name": "day", "quantity": "time", "kind": "accepted", "prefixes": []},
  {"symbol": "L", "name": "litre", "quantity": "volume", "kind": "accepted", "prefixes": ["m", "μ", "d", "c", "n"]},
  {"symbol": "t", "name": "tonne", "quantity": "mass", "kind": "accepted", "prefixes": []},
  {"symbol": "eV", "name": "electronvolt", "quantity": "energy", "kind": "accepted", "prefixes": ["k", "M", "G", "T"]},
  {"symbol": "bar", "name": "bar", "quantity": "pressure", "kind": "accepted", "prefixes": ["m"]},
  {"symbol": "Da", "name": "dalton", "quantity": "mass", "kind": "accepted", "prefixes": ["k", "M"]},

  {"symbol": "M", "name": "molar", "quantity": "concentration", "kind": "subject", "prefixes": ["m", "μ", "n", "p"]},
  {"symbol": "IU", "name": "international unit", "quantity": "biological activity", "kind": "subject", "prefixes": ["m"]},
  {"symbol": "mmHg", "name": "millimetre of mercury", "quantity": "pressure", "kind": "subject", "prefixes": []},
  {"symbol": "cal", "name": "calorie", "quantity": "energy", "kind": "subject", "prefixes": ["k"]},
  {"symbol": "ppm", "name": "parts per million", "quantity": "ratio", "kind": "subject", "prefixes": []},
  {"symbol": "ppb", "name": "parts per billion", "quantity": "ratio", "kind": "subject", "prefixes": []},
  {"symbol": "rpm", "name": "revolutions per minute", "quantity": "rotational speed", "kind": "subject", "prefixes": []},
  {"symbol": "bpm", "name": "beats per minute", "quantity": "rate", "kind": "subject", "prefixes": []},
  {"symbol": "B", "name": "byte", "quantity": "data", "kind": "subject", "prefixes": ["k", "M", "G", "T"], "bare": false}
 ],
 "renames": {
  "sec": "s", "secs": "s", "msec": "ms", "usec": "μs",
  "hr": "h", "hrs": "h", "mins": "min",
  "amp": "A", "amps": "A",
  "cps": "Hz",
  "mho": "S", "mhos": "S",
  "micron": "μm", "microns": "μm",
  "cc": "mL",
  "ltr": "L", "ltrs": "L",
  "gm": "g", "gms": "g",
  "mtr": "m", "mtrs": "m"
 },
 "convert": {
  "ft": "m", "feet": "m", "foot": "m", "yd": "m", "mi": "km", "mile": "km", "miles": "km",
  "lb": "kg", "lbs": "kg", "oz": "g", "gal": "L", "gallon": "L", "gallons": "L",
  "psi": "kPa", "atm": "kPa", "torr": "kPa", "Torr": "kPa", "mmHg": "kPa",
  "cal": "J", "kcal": "kJ", "Å": "nm", "Ci": "Bq", "mCi": "MBq", "rem": "Sv", "mrem": "mSv",
  "dyn": "N", "dyne": "N", "erg": "J"
 },
 "default_exceptions": ["mmHg", "kcal", "cal"],
 "never_units": ["AM", "PM", "am", "pm", "in", "IN", "at", "As", "As", "Am"]
}

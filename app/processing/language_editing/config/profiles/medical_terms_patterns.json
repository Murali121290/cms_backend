    {
      "id": "MED-SP12",
      "name": "-ise and -isation to -ize and -ization",
      "pattern": "\\b(catheter|hospital|immun|steril|stabil|sensit|random|standard|minim|maxim|organ|recogn|util|emphas|categor|summar|general|individual|visual|mobil|normal|neutral|crystall|metabol|cauter|vaccin|ioniz|fertil)is(e|es|ed|ing|ation|ations)\\b",
      "replacement": "\\1iz\\2",
      "flags": [
        "IGNORECASE"
      ],
      "tool_behaviour": "flag",
      "action_raw": "Flag and suggest",
      "style_profile": "US spelling",
      "example_wrong": "catheterised and randomisation",
      "example_right": "catheterized and randomization",
      "must_not_change": "exercise | organisms | promise",
      "note": "Style choice, so flag rather than fix."
    },
    {
      "id": "MED-SP13",

  "entries": [
    {
      "id": "MED-SP01",
      "name": "haem- to hem-",
      "pattern": "\\b([a-z]*)haem(?!ophilus)(o|a)",
      "replacement": "\\1hem\\2",
      "flags": [
        "IGNORECASE"
      ],
      "tool_behaviour": "auto_replace",
      "action_raw": "Auto-fix",
      "style_profile": "US spelling",
      "example_wrong": "haemoglobin and haemorrhage",
      "example_right": "hemoglobin and hemorrhage",
      "must_not_change": "Haemophilus influenzae | hemoglobin",
      "note": "The genus Haemophilus keeps its ae. The lookahead protects it."
    },
    {
      "id": "MED-SP02",
      "name": "-aemia and -aemic to -emia and -emic",
      "pattern": "\\b([a-z]*?)aemi(a|c)\\b",
      "replacement": "\\1emi\\2",
      "flags": [
        "IGNORECASE"
      ],
      "tool_behaviour": "auto_replace",
      "action_raw": "Auto-fix",
      "style_profile": "US spelling",
      "example_wrong": "anaemia and leukaemia",
      "example_right": "anemia and leukemia",
      "must_not_change": "anemia | leukemia",
      "note": "Covers ischaemia, hyperglycaemia and septicaemic."
    },
    {
      "id": "MED-SP03",

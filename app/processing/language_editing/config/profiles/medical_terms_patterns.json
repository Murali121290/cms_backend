    {
      "id": "MED-SP21",
      "name": "Lowercase genus name",
      "pattern": "\\b(escherichia|staphylococcus|streptococcus|pseudomonas|klebsiella|helicobacter|mycobacterium|neisseria|haemophilus|salmonella|shigella|legionella|candida|plasmodium|treponema|chlamydia|enterococcus|bacillus|listeria|vibrio|borrelia|clostridioides|clostridium|pneumocystis|aspergillus)(?= [a-z]{4,}\\b)",
      "replacement": "{cap:1}",
      "flags": [],
      "tool_behaviour": "flag",
      "action_raw": "Flag and suggest",
      "style_profile": "All",
      "example_wrong": "escherichia coli and staphylococcus aureus",
      "example_right": "Escherichia coli and Staphylococcus aureus",
      "must_not_change": "Escherichia coli | the coliform",
      "note": "Capitalize the first letter of the genus. Then italicize genus and species."

{
  "rules": [
    {
      "id": "URL001",
      "name": "Internal Link Check",
      "target_path": "OEBPS/xhtml",
      "enabled": true,
      "file_name_pattern": [
        "*_chapter*.xhtml",
        "*_ch*.xhtml"
      ]
    },
    {
      "id": "URL002",
      "name": "External Link Check",
      "target_path": "OEBPS/xhtml",
      "enabled": true,
      "file_name_pattern": [
        "*_chapter*.xhtml",
        "*_ch*.xhtml"
      ]
    },
    {
      "id": "URL003",
      "name": "URL Text Match Check",
      "target_path": "OEBPS/xhtml",
      "enabled": true,
      "file_name_pattern": [
        "*_chapter*.xhtml",
        "*_ch*.xhtml"
      ]
    },
    {
      "id": "URL004",
      "name": "PDF–EPUB Link Match",
      "scope": "book",
      "enabled": true
    }
  ]
}
{
  "rules": [
    {
      "id": "STRUCT001",
      "name": "EPUB Folder Structure Check",
      "scope": "book",
      "enabled": true
    },
    {
      "id": "STRUCT002",
      "name": "Container File Check",
      "scope": "book",
      "enabled": true
    },
    {
      "id": "STRUCT003",
      "name": "EPUB Content Folder Check",
      "scope": "book",
      "rule_config": {
        "opf_name": "isbn",
        "css_folder": "css",
        "css_file": "epub.css",
        "xhtml_folder": "xhtml",
        "images_folder": "images",
        "nav_file": "nav.xhtml",
        "toc_file": "toc.ncx"
      },
      "enabled": true
    },
    {
      "id": "STRUCT004",
      "name": "EPUB File Extension Check",
      "scope": "book",
      "enabled": true
    },
    {
      "id": "CSS002",
      "name": "CSS File Validation",
      "target_path": "OEBPS/css",
      "enabled": true,
      "file_name_pattern": "*.css"
    },
    {
      "id": "XHTML001",
      "name": "XHTML Syntax Check",
      "target_path": "OEBPS/xhtml",
      "file_name_pattern": "*.xhtml",
      "enabled": true
    },
    {
      "id": "URL001",
      "name": "Internal Link Check",
      "target_path": "OEBPS/xhtml",
      "enabled": true,
      "file_name_pattern": "*.xhtml"
    },
    {
      "id": "URL002",
      "name": "External Link Check",
      "target_path": "OEBPS/xhtml",
      "enabled": true,
      "file_name_pattern": "*.xhtml"
    },
    {
      "id": "URL003",
      "name": "URL Text Match Check",
      "target_path": "OEBPS/xhtml",
      "enabled": true,
      "file_name_pattern": "*.xhtml"
    },
    {
      "id": "NAV001",
      "name": "NAV TOC Link Check",
      "target_path": "",
      "enabled": true,
      "file_name_pattern": "nav.xhtml"
    },
    {
      "id": "NAV002",
      "name": "NCX and Navigation link Check",
      "target_path": "",
      "enabled": true,
      "file_name_pattern": "toc.ncx"
    },
    {
      "id": "NAV004",
      "name": "Cover Entry in TOC",
      "target_path": "",
      "enabled": true,
      "file_name_pattern": "nav.xhtml"
    },
    {
      "id": "NAV005",
      "name": "Page List Link Check",
      "target_path": "",
      "enabled": true,
      "file_name_pattern": "nav.xhtml"
    },
    {
      "id": "ASP-COV-001",
      "name": "Aspen: Cover file named cover.jpg",
      "scope": "book",
      "enabled": true
    },
    {
      "id": "ASP-COV-002",
      "name": "Aspen: Cover height is 1100 pixels",
      "target_path": "OEBPS/images",
      "file_name_pattern": "cover.jpg",
      "enabled": true
    },
    {
      "id": "ASP-COV-003",
      "name": "Aspen: Cover image is 300 DPI",
      "target_path": "OEBPS/images",
      "file_name_pattern": "cover.jpg",
      "enabled": true
    },
    {
      "id": "ASP-COV-004",
      "name": "Aspen: Back cover image is not required",
      "scope": "book",
      "enabled": true
    },
    {
      "id": "ASP-FILE-001",
      "name": "Aspen: EPUB file named '<eISBN>_EPUB.epub'",
      "scope": "book",
      "enabled": false
    },
    {
      "id": "ASP-NAV-001",
      "name": "Aspen: Cover and Front Matter present in NAV",
      "target_path": "",
      "file_name_pattern": "nav.xhtml",
      "enabled": true
    },
    {
      "id": "ASP-NAV-002",
      "name": "Aspen: 'Half title' word forbidden in NAV/NCX",
      "target_path": "",
      "file_name_pattern": [
        "nav.xhtml",
        "toc.ncx"
      ],
      "enabled": true
    },
    {
      "id": "ASP-NAV-003",
      "name": "Aspen: Authors separated by ',' not 'and' in OPF/NCX",
      "scope": "book",
      "enabled": false
    },
    {
      "id": "ASP-COPY-001",
      "name": "Aspen: Copyright page must not contain 'Printed'",
      "target_path": "OEBPS/xhtml",
      "file_name_pattern": [
        "*Copyright*.xhtml",
        "*copyright*.xhtml"
      ],
      "enabled": true
    },
    {
      "id": "ASP-COPY-002",
      "name": "Aspen: Copyright page must contain the eISBN",
      "target_path": "OEBPS/xhtml",
      "file_name_pattern": [
        "*Copyright*.xhtml",
        "*copyright*.xhtml"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-001",
      "name": "Aspen: OPF dc:publisher = 'Aspen Publishing'",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-002",
      "name": "Aspen: OPF dc:rights match Copyright string",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-003",
      "name": "Aspen: OPF a11y:certifiedBy = 'S4Carlisle Publishing Services'",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-004",
      "name": "Aspen: OPF dcterms:conformsTo = 'EPUB Accessibility 1.1 - WCAG 2.2 Level AA'",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-005",
      "name": "Aspen: OPF dc:title is Title Case",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-006",
      "name": "Aspen: OPF dc:date is current year",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-007",
      "name": "Aspen: OPF dc:format page count matches PDF",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-008",
      "name": "Aspen: OPF dc:type = 'Text'",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-009",
      "name": "Aspen: OPF dc:identifier id attribute starts with 'Epub-'",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-010",
      "name": "Aspen: OPF dc:language = 'en' or 'en-US'",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-011",
      "name": "Aspen: OPF accessibilityHazard contains 'none' or no-hazard declarations",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-012",
      "name": "Aspen: OPF accessMode contains both 'textual' and 'visual'",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-013",
      "name": "Aspen: OPF accessModeSufficient contains both 'textual,visual' and 'textual'",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-014",
      "name": "Aspen: <dc:creator> count matches Front Matter author count",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-015",
      "name": "Aspen: OPF dcterms:modified ISO timestamp check",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-016",
      "name": "Aspen: OPF accessibilityFeature required values check",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-017",
      "name": "Aspen: OPF accessibilitySummary present check",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-018",
      "name": "Aspen: OPF meta name='cover' content resolves to manifest item id",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-019",
      "name": "Aspen: OPF source-of=pagination refines tag check",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-IMG-001",
      "name": "Aspen: All manifest images must be JPEG",
      "target_path": "OEBPS/images",
      "file_name_pattern": "*.*",
      "rule_config": {
        "allowed_extensions": [
          ".jpg",
          ".jpeg"
        ]
      },
      "enabled": true
    },
    {
      "id": "ASP-IMG-002",
      "name": "Aspen: <img> alt attribute must not be empty",
      "target_path": "OEBPS/xhtml",
      "file_name_pattern": "*.xhtml",
      "enabled": true
    },
    {
      "id": "ASP-IMG-003",
      "name": "Aspen: No image over 4,000,000 pixels (W×H)",
      "target_path": "OEBPS/images",
      "file_name_pattern": "*.jpg",
      "enabled": true
    },
    {
      "id": "ASP-IMG-004",
      "name": "Aspen: Long alt text should be moved to a hidden container",
      "target_path": "OEBPS/xhtml",
      "file_name_pattern": "*.xhtml",
      "enabled": false
    },
    {
      "id": "ASP-IMG-005",
      "name": "Aspen: All body images must be at least 300 DPI",
      "target_path": "OEBPS/images",
      "file_name_pattern": "*.jpg",
      "enabled": true
    },
    {
      "id": "ASP-IMG-006",
      "name": "Aspen: <img> should be center-aligned via class or inline style",
      "target_path": "OEBPS/xhtml",
      "file_name_pattern": "*.xhtml",
      "enabled": false
    },
    {
      "id": "ASP-PAGE-001",
      "name": "Aspen: Page ruler (pagebreak marker) present for every non-blank PDF page",
      "scope": "book",
      "enabled": false
    },
    {
      "id": "ASP-LINK-001",
      "name": "Aspen: Page citations must be linked to the corresponding page ID",
      "target_path": "OEBPS/xhtml",
      "file_name_pattern": "*.xhtml",
      "enabled": true
    },
    {
      "id": "ASP-LINK-002",
      "name": "Aspen: Glossary terms have two-way links between body and glossary",
      "scope": "book",
      "enabled": false
    },
    {
      "id": "ASP-LINK-003",
      "name": "Aspen: External links must not have underline styling",
      "scope": "book",
      "enabled": false
    }
  ],
  "export": {
    "filename_format": "{eisbn}_EPUB.epub"
  }
}
{
  "rules": [
    {
      "id": "STRUCT001",
      "name": "EPUB Folder Structure Check",
      "scope": "book",
      "enabled": true
    },
    {
      "id": "STRUCT002",
      "name": "Container File Check",
      "scope": "book",
      "enabled": true
    },
    {
      "id": "STRUCT003",
      "name": "EPUB Content Folder Check",
      "scope": "book",
      "rule_config": {
        "opf_name": "isbn",
        "css_folder": "css",
        "css_file": "epub.css",
        "xhtml_folder": "xhtml",
        "images_folder": "images",
        "nav_file": "nav.xhtml",
        "toc_file": "toc.ncx"
      },
      "enabled": true
    },
    {
      "id": "STRUCT004",
      "name": "EPUB File Extension Check",
      "scope": "book",
      "enabled": true
    },
    {
      "id": "CSS002",
      "name": "CSS File Validation",
      "target_path": "OEBPS/css",
      "enabled": true,
      "file_name_pattern": "*.css"
    },
    {
      "id": "XHTML001",
      "name": "XHTML Syntax Check",
      "target_path": "OEBPS/xhtml",
      "file_name_pattern": "*.xhtml",
      "enabled": true
    },
    {
      "id": "URL001",
      "name": "Internal Link Check",
      "target_path": "OEBPS/xhtml",
      "enabled": true,
      "file_name_pattern": "*.xhtml"
    },
    {
      "id": "URL002",
      "name": "External Link Check",
      "target_path": "OEBPS/xhtml",
      "enabled": true,
      "file_name_pattern": "*.xhtml"
    },
    {
      "id": "URL003",
      "name": "URL Text Match Check",
      "target_path": "OEBPS/xhtml",
      "enabled": true,
      "file_name_pattern": "*.xhtml"
    },
    {
      "id": "URL006",
      "name": "Aspen: Plain text URLs must be wrapped in an <a> tag",
      "target_path": "OEBPS/xhtml",
      "file_name_pattern": "*.xhtml",
      "enabled": true
    },
    {
      "id": "NAV001",
      "name": "NAV TOC Link Check",
      "target_path": "",
      "enabled": true,
      "file_name_pattern": "nav.xhtml"
    },
    {
      "id": "NAV002",
      "name": "NCX and Navigation link Check",
      "target_path": "",
      "enabled": true,
      "file_name_pattern": "toc.ncx"
    },
    {
      "id": "NAV004",
      "name": "Cover Entry in TOC",
      "target_path": "",
      "enabled": true,
      "file_name_pattern": "nav.xhtml"
    },
    {
      "id": "NAV005",
      "name": "Page List Link Check",
      "target_path": "",
      "enabled": true,
      "file_name_pattern": "nav.xhtml"
    },
    {
      "id": "ASP-COV-001",
      "name": "Aspen: Cover file named cover.jpg",
      "scope": "book",
      "enabled": true
    },
    {
      "id": "ASP-COV-002",
      "name": "Aspen: Cover height is 1100 pixels",
      "target_path": "OEBPS/images",
      "file_name_pattern": "cover.jpg",
      "enabled": true,
      "rule_config": {
        "expected_height": 1100
      }
    },
    {
      "id": "ASP-COV-003",
      "name": "Aspen: Cover image is exactly 300 DPI",
      "target_path": "OEBPS/images",
      "file_name_pattern": "cover.jpg",
      "enabled": true,
      "rule_config": {
        "expected_dpi": 300
      }
    },
    {
      "id": "ASP-COV-004",
      "name": "Aspen: Back cover image is not required",
      "scope": "book",
      "enabled": true
    },
    {
      "id": "ASP-FILE-001",
      "name": "Aspen: EPUB file named '<eISBN>_EPUB.epub'",
      "scope": "book",
      "enabled": false
    },
    {
      "id": "ASP-NAV-001",
      "name": "Aspen: Cover and Front Matter present in NAV",
      "target_path": "",
      "file_name_pattern": "nav.xhtml",
      "enabled": true
    },
    {
      "id": "ASP-NAV-002",
      "name": "Aspen: 'Half title' word forbidden in NAV/NCX",
      "target_path": "",
      "file_name_pattern": [
        "nav.xhtml",
        "toc.ncx"
      ],
      "enabled": true
    },
    {
      "id": "ASP-NAV-003",
      "name": "Aspen: Authors separated by ',' not 'and' in OPF/NCX",
      "scope": "book",
      "enabled": false
    },
    {
      "id": "ASP-COPY-001",
      "name": "Aspen: Copyright page must not contain 'Printed'",
      "target_path": "OEBPS/xhtml",
      "file_name_pattern": [
        "*Copyright*.xhtml",
        "*copyright*.xhtml"
      ],
      "enabled": true
    },
    {
      "id": "ASP-COPY-002",
      "name": "Aspen: Copyright page must contain the eISBN",
      "target_path": "OEBPS/xhtml",
      "file_name_pattern": [
        "*Copyright*.xhtml",
        "*copyright*.xhtml"
      ],
      "enabled": true
    },
    {
      "id": "COM-META-001",
      "name": "OPF dc:publisher = 'Aspen Publishing'",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true,
      "rule_config": {
        "expected_publisher": "Aspen Publishing"
      }
    },
    {
      "id": "COM-META-002",
      "name": "OPF dc:rights match Copyright string",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true,
      "rule_config": {
        "expected_rights_pattern": "copyright\\s*©\\s*\\d{4}\\s+aspen\\s+publishing\\.?\\s+all\\s+rights\\s+reserved\\.?"
      }
    },
    {
      "id": "ASP-META-003",
      "name": "Aspen: OPF a11y:certifiedBy = 'S4Carlisle Publishing Services'",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-004",
      "name": "Aspen: OPF dcterms:conformsTo = 'EPUB Accessibility 1.1 - WCAG 2.2 Level AA'",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-005",
      "name": "Aspen: OPF dc:title is Title Case",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-006",
      "name": "Aspen: OPF dc:date is current year",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-007",
      "name": "Aspen: OPF dc:format page count matches PDF",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-008",
      "name": "Aspen: OPF dc:type = 'Text'",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-009",
      "name": "Aspen: OPF dc:identifier id attribute starts with 'Epub-'",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-010",
      "name": "Aspen: OPF dc:language = 'en' or 'en-US'",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-011",
      "name": "Aspen: OPF accessibilityHazard contains 'none' or no-hazard declarations",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-012",
      "name": "Aspen: OPF accessMode contains both 'textual' and 'visual'",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-013",
      "name": "Aspen: OPF accessModeSufficient contains both 'textual,visual' and 'textual'",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-014",
      "name": "Aspen: <dc:creator> count matches Front Matter author count",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-015",
      "name": "Aspen: OPF dcterms:modified ISO timestamp check",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-016",
      "name": "Aspen: OPF accessibilityFeature required values check",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-017",
      "name": "Aspen: OPF accessibilitySummary present check",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-018",
      "name": "Aspen: OPF meta name='cover' content resolves to manifest item id",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-META-019",
      "name": "Aspen: OPF source-of=pagination refines tag check",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true
    },
    {
      "id": "ASP-IMG-001",
      "name": "Aspen: All manifest images must be JPEG",
      "target_path": "OEBPS/images",
      "file_name_pattern": "*.*",
      "rule_config": {
        "allowed_extensions": [
          ".jpg",
          ".jpeg"
        ]
      },
      "enabled": true
    },
    {
      "id": "ASP-IMG-002",
      "name": "Aspen: <img> alt attribute must not be empty",
      "target_path": "OEBPS/xhtml",
      "file_name_pattern": "*.xhtml",
      "enabled": true
    },
    {
      "id": "ASP-IMG-003",
      "name": "Aspen: No image over 4,000,000 pixels (W×H)",
      "target_path": "OEBPS/images",
      "file_name_pattern": "*.jpg",
      "enabled": true
    },
    {
      "id": "ASP-IMG-004",
      "name": "Aspen: Long alt text should be moved to a hidden container",
      "target_path": "OEBPS/xhtml",
      "file_name_pattern": "*.xhtml",
      "enabled": false
    },
    {
      "id": "IMG-001",
      "name": "Aspen: All body images must be exactly 300 DPI",
      "target_path": "OEBPS/images",
      "file_name_pattern": "*.jpg",
      "enabled": true,
      "rule_config": {
        "expected_dpi": 300,
        "exclude_files": [
          "cover.jpg"
        ]
      }
    },
    {
      "id": "ASP-IMG-005",
      "name": "Aspen: <img> should be center-aligned via class only",
      "target_path": "OEBPS/xhtml",
      "file_name_pattern": "*.xhtml",
      "enabled": true
    },
    {
      "id": "ASP-TXT-001",
      "name": "Aspen: First <p> tag following each <h1..h6> heading must use a consistent class name",
      "target_path": "OEBPS/xhtml",
      "file_name_pattern": "*.xhtml",
      "enabled": true
    },
    {
      "id": "ASP-PAGE-001",
      "name": "Aspen: Page ruler (pagebreak marker) present for every non-blank PDF page",
      "scope": "book",
      "enabled": false
    },
    {
      "id": "COM-LINK-001",
      "name": "Aspen: citations must be linked to the corresponding block",
      "target_path": "OEBPS/xhtml",
      "file_name_pattern": [
        "*_chapter*.xhtml",
        "*_chap*.xhtml",
        "*_ch*.xhtml",
        "*chapter*.xhtml",
        "*chap*.xhtml",
        "*ch[0-9]*.xhtml"
      ],
      "enabled": true,
      "rule_config": {
        "citation_regex": "\\b(?:see\\s+)?(?:(?:pages?|pp\\.|p\\.)(?![a-zA-Z])[ \\t\\-]*(\\d{1,4})(?:[ \\t]*[\\-\u2013][ \\t]*\\d{1,4})?|(?:chapter|chap\\.|ch\\.)(?![a-zA-Z])[ \\t\\-]*(\\d+(?:[.\\-\u2013][a-zA-Z0-9]+)*[a-zA-Z]?|(?!(?:did|mix|civil|mid|mild|vivid|dim|ill|mill|lid|dill|div|vic|doc)\\b)[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z]))(?:[ \\t]*[\\-\u2013][ \\t]*\\d+(?:[a-zA-Z]?\\.?\\d+)*(?:\\.\\w+)*)?|(?:figure|fig\\.)(?![a-zA-Z])[ \\t\\-]*(\\d+(?:[.\\-\u2013][a-zA-Z0-9]+)*[a-zA-Z]?|(?!(?:did|mix|civil|mid|mild|vivid|dim|ill|mill|lid|dill|div|vic|doc)\\b)[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z]))|(?:table|tbl\\.)(?![a-zA-Z])[ \\t\\-]*(\\d+(?:[.\\-\u2013][a-zA-Z0-9]+)*[a-zA-Z]?|(?!(?:did|mix|civil|mid|mild|vivid|dim|ill|mill|lid|dill|div|vic|doc)\\b)[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z]))|(?:exhibit|exh\\.)(?![a-zA-Z])[ \\t\\-]*(\\d+(?:[.\\-\u2013][a-zA-Z0-9]+)*[a-zA-Z]?|(?!(?:did|mix|civil|mid|mild|vivid|dim|ill|mill|lid|dill|div|vic|doc)\\b)[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z]))|(?:plate|pl\\.)(?![a-zA-Z])[ \\t\\-]*(\\d+(?:[.\\-\u2013][a-zA-Z0-9]+)*[a-zA-Z]?|(?!(?:did|mix|civil|mid|mild|vivid|dim|ill|mill|lid|dill|div|vic|doc)\\b)[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z]))|map(?![a-zA-Z])[ \\t\\-]*(\\d+(?:[.\\-\u2013][a-zA-Z0-9]+)*[a-zA-Z]?|(?!(?:did|mix|civil|mid|mild|vivid|dim|ill|mill|lid|dill|div|vic|doc)\\b)[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z]))|box(?![a-zA-Z])[ \\t\\-]*(\\d+(?:[.\\-\u2013][a-zA-Z0-9]+)*[a-zA-Z]?|(?!(?:did|mix|civil|mid|mild|vivid|dim|ill|mill|lid|dill|div|vic|doc)\\b)[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z]))|(?:section|sec\\.)(?![a-zA-Z])[ \\t\\-]*(\\d+(?:[.\\-\u2013][a-zA-Z0-9]+)*[a-zA-Z]?|(?!(?:did|mix|civil|mid|mild|vivid|dim|ill|mill|lid|dill|div|vic|doc)\\b)[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z]))|(?:part|pt\\.)(?![a-zA-Z])[ \\t\\-]*(\\d+(?:[.\\-\u2013][a-zA-Z0-9]+)*[a-zA-Z]?|(?!(?:did|mix|civil|mid|mild|vivid|dim|ill|mill|lid|dill|div|vic|doc)\\b)[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z]))|(?:appendix|app\\.)(?![a-zA-Z])[ \\t\\-]*([1-9]|10|[A-K])|(?:illustration|illus\\.)(?![a-zA-Z])[ \\t\\-]*(\\d+(?:[.\\-\u2013][a-zA-Z0-9]+)*[a-zA-Z]?|(?!(?:did|mix|civil|mid|mild|vivid|dim|ill|mill|lid|dill|div|vic|doc)\\b)[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z])))\\b"
      }
    },
    {
      "id": "ASP-LINK-002",
      "name": "Aspen: Glossary terms have two-way links between body and glossary",
      "scope": "book",
      "enabled": false
    },
    {
      "id": "ASP-LINK-003",
      "name": "Aspen: External links must not have underline styling",
      "scope": "book",
      "enabled": false
    },
    {
      "id": "TOC-MERGE-001",
      "name": "TOC Line Merge",
      "target_path": "OEBPS/xhtml",
      "file_name_pattern": "*Contents.xhtml",
      "enabled": true
    }
  ],
  "export": {
    "filename_format": "{eisbn}_EPUB.epub"
  }
}
{
  "rules": [
    {
      "id": "GWP-META-000",
      "name": "OPF Version Check",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true,
      "category": "Metadata Check"
    },
    {
      "id": "COM-META-001",
      "name": "OPF dc:publisher = 'The Goodheart-Willcox Company, Inc'",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true,
      "rule_config": {
        "expected_publisher": "The Goodheart-Willcox Company, Inc"
      },
      "category": "Metadata Check"
    },
    {
      "id": "COM-META-002",
      "name": "OPF dc:rights match Copyright string",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true,
      "rule_config": {
        "expected_rights_pattern": "copyright\\s*\u00a9\\s*\\d{4}\\s+by\\s+the\\s+goodheart-willcox\\s+company,\\s+inc\\.?"
      },
      "category": "Metadata Check"
    },
    {
      "id": "COM-META-003",
      "name": "OPF Basic Metadata Presence",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true,
      "rule_config": {
        "required_tags": [
          "dc:title",
          "dc:creator",
          "dc:identifier",
          "dc:language",
          "dc:date",
          "dc:source",
          "dc:publisher",
          "dc:description",
          "dc:rights"
        ]
      },
      "category": "Metadata Check"
    },
    {
      "id": "COM-META-005",
      "name": "pageBreakSource Metadata",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true,
      "rule_config": {
        "required_prefix": "urn:isbn:"
      },
      "category": "Metadata Check"
    },
    {
      "id": "COM-META-006",
      "name": "accessMode Metadata",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true,
      "rule_config": {
        "expected_values": [
          "textual",
          "visual"
        ]
      },
      "category": "Metadata Check"
    },
    {
      "id": "COM-META-007",
      "name": "accessModeSufficient Metadata",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true,
      "rule_config": {
        "expected_values": [
          "textual,visual",
          "textual"
        ]
      },
      "category": "Metadata Check"
    },
    {
      "id": "COM-META-008",
      "name": "accessibilityFeature Metadata",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true,
      "rule_config": {
        "expected_values": [
          "readingOrder",
          "structuralNavigation",
          "ARIA",
          "tableOfContents",
          "pageBreakMarkers",
          "pageNavigation",
          "displayTransformability",
          "index",
          "alternativeText",
          "longDescription"
        ],
        "conditional_mathml_values": [
          "MathML",
          "describedMath"
        ]
      },
      "category": "Metadata Check"
    },
    {
      "id": "COM-META-009",
      "name": "accessibilitySummary Metadata",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true,
      "rule_config": {
        "expected_summary": "A very complex book with a lot of images, tables, list items and complex formatting, which are defined with accessible structural markup. There are multiple linked references to various figures in this EPUB however there are no back links provided. There is a page list and embedded page-breaks within this EPUB to aid in the ability to go to a specific page. Additionally, blank pages have been removed from the EPUB while their page break labels have been left in, for reasons of structural flow.",
        "is_required": false
      },
      "category": "Metadata Check"
    },
    {
      "id": "COM-META-010",
      "name": "accessibilityHazard Metadata",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true,
      "rule_config": {
        "expected_values": [
          "none"
        ]
      },
      "category": "Metadata Check"
    },
    {
      "id": "COM-META-011",
      "name": "dcterms:conformsTo Metadata",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true,
      "rule_config": {
        "expected_text": "EPUB Accessibility 1.1 - WCAG 2.2 Level AA"
      },
      "category": "Metadata Check"
    },
    {
      "id": "COM-META-012",
      "name": "a11y:certifiedBy Metadata",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true,
      "rule_config": {
        "expected_text": "Benetech"
      },
      "category": "Metadata Check"
    },
    {
      "id": "COM-META-013",
      "name": "a11y:certifierCredential Metadata",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true,
      "rule_config": {
        "expected_text": "https://bornaccessible.org/certification/gca-credential/"
      },
      "category": "Metadata Check"
    },
    {
      "id": "COM-SPINE-001",
      "name": "Alt.xhtml Spine linear='no' Check",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.opf"
      ],
      "enabled": true,
      "rule_config": {
        "file_suffix": "Alt.xhtml",
        "expected_linear": "no"
      },
      "category": "Metadata Check"
    },
    {
      "id": "COM-NAV-001",
      "name": "Navigation epub:type='toc'",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "nav.xhtml"
      ],
      "enabled": true,
      "rule_config": {
        "expected_type": "toc"
      },
      "category": "Navigation Check"
    },
    {
      "id": "COM-NAV-002",
      "name": "Navigation epub:type='page-list'",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "nav.xhtml"
      ],
      "enabled": true,
      "rule_config": {
        "expected_type": "page-list"
      },
      "category": "Navigation Check"
    },
    {
      "id": "COM-NAV-003",
      "name": "Navigation epub:type='landmarks'",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "nav.xhtml"
      ],
      "enabled": true,
      "rule_config": {
        "expected_type": "landmarks"
      },
      "category": "Navigation Check"
    },
    {
      "id": "STRUCT001",
      "name": "EPUB Folder Structure Check",
      "scope": "book",
      "enabled": true,
      "category": "Structure Check"
    },
    {
      "id": "STRUCT002",
      "name": "Container File Check",
      "scope": "book",
      "enabled": true,
      "category": "Structure Check"
    },
    {
      "id": "STRUCT003",
      "name": "EPUB Content Folder Check",
      "scope": "book",
      "rule_config": {
        "opf_name": "content.opf",
        "css_folder": "Styles",
        "css_file": "stylesheet.css",
        "xhtml_folder": "Text",
        "images_folder": "Images",
        "fonts_folder": "Fonts",
        "nav_file": "nav.xhtml",
        "toc_file": "toc.ncx"
      },
      "enabled": true,
      "category": "Structure Check"
    },
    {
      "id": "STRUCT005",
      "name": "Sequential XHTML Naming Check",
      "scope": "book",
      "rule_config": {
        "xhtml_folder": "Text",
        "start_number": 1
      },
      "enabled": true,
      "category": "Structure Check"
    },
    {
      "id": "CSS002",
      "name": "CSS File Validation",
      "target_path": "OEBPS/Styles",
      "enabled": true,
      "file_name_pattern": "*.css",
      "category": "CSS Check"
    },
    {
      "id": "XHTML001",
      "name": "XHTML Syntax Check",
      "target_path": "OEBPS/Text",
      "file_name_pattern": "*.xhtml",
      "enabled": true,
      "category": "XHTML Check"
    },
    {
      "id": "URL001",
      "name": "Internal Link Check",
      "target_path": "OEBPS/Text",
      "enabled": false,
      "file_name_pattern": "*.xhtml",
      "category": "Link Check"
    },
    {
      "id": "URL002",
      "name": "External Link Check",
      "target_path": "OEBPS/Text",
      "enabled": false,
      "file_name_pattern": "*.xhtml",
      "category": "Link Check"
    },
    {
      "id": "COM-LINK-001",
      "name": "Internal Cross-Reference Check",
      "target_path": "OEBPS/Text",
      "enabled": true,
      "file_name_pattern": "*.xhtml",
      "rule_config": {
        "citation_regex": "\\b(?:see\\s+)?(?:p(?:ages?|p)?(?![a-zA-Z])\\.?[ \\t\\-]*(\\d{1,4})(?:[ \\t]*[\\-\u2013][ \\t]*\\d{1,4})?|ch(?:apter|ap)?(?![a-zA-Z])\\.?[ \\t\\-]*(\\d+(?:[.\\-\u2013][a-zA-Z0-9]+)*[a-zA-Z]?|[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z]))(?:[ \\t]*[\\-\u2013][ \\t]*\\d+(?:[a-zA-Z]?\\.?\\d+)*(?:\\.\\w+)*)?|fig(?:ure)?(?![a-zA-Z])\\.?[ \\t\\-]*(\\d+(?:[.\\-\u2013][a-zA-Z0-9]+)*[a-zA-Z]?|[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z]))|(?:tbl\\.?|table)(?![a-zA-Z])[ \\t\\-]*(\\d+(?:[.\\-\u2013][a-zA-Z0-9]+)*[a-zA-Z]?|[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z]))|unit\\.?[ \\t]*(\\d+(?:[.\\-\u2013][a-zA-Z0-9]+)*[a-zA-Z]?|[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z]))|lesson\\.?[ \\t]*(\\d+(?:[.\\-\u2013][a-zA-Z0-9]+)*[a-zA-Z]?|[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z]))|(?:exh\\.?|exhibit)(?![a-zA-Z])\\.?[ \\t\\-]*(\\d+(?:[.\\-\u2013][a-zA-Z0-9]+)*[a-zA-Z]?|[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z]))|(?:pl\\.?|plate)(?![a-zA-Z])\\.?[ \\t\\-]*(\\d+(?:[.\\-\u2013][a-zA-Z0-9]+)*[a-zA-Z]?|[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z]))|map(?![a-zA-Z])\\.?[ \\t\\-]*(\\d+(?:[.\\-\u2013][a-zA-Z0-9]+)*[a-zA-Z]?|[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z]))|box(?![a-zA-Z])\\.?[ \\t\\-]*(\\d+(?:[.\\-\u2013][a-zA-Z0-9]+)*[a-zA-Z]?|[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z]))|(?:sec\\.?|section)(?![a-zA-Z])\\.?[ \\t\\-]*(\\d+(?:[.\\-\u2013][a-zA-Z0-9]+)*[a-zA-Z]?|[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z]))|(?:pt\\.?|part)(?![a-zA-Z])\\.?[ \\t\\-]*(\\d+(?:[.\\-\u2013][a-zA-Z0-9]+)*[a-zA-Z]?|[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z]))|(?:app\\.?|appendix)(?![a-zA-Z])\\.?[ \\t\\-]*(\\d+(?:[.\\-\u2013][a-zA-Z0-9]+)*[a-zA-Z]?|[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z]))|(?:illus\\.?|illustration)(?![a-zA-Z])\\.?[ \\t\\-]*(\\d+(?:[.\\-\u2013][a-zA-Z0-9]+)*[a-zA-Z]?|[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z])))\\b"
      },
      "category": "Link Check"
    },
    {
      "id": "NAV001",
      "name": "NAV TOC Link Check",
      "target_path": "OEBPS",
      "enabled": true,
      "file_name_pattern": "nav.xhtml",
      "category": "Navigation Check"
    },
    {
      "id": "INDEX001",
      "name": "Index Link Check",
      "target_path": "OEBPS",
      "enabled": true,
      "file_name_pattern": "*index*.xhtml",
      "category": "Index Check"
    },
    {
      "id": "INDEX002",
      "name": "Index Unordered List Format Check",
      "target_path": "OEBPS",
      "enabled": true,
      "file_name_pattern": "*index*.xhtml",
      "category": "Index Check"
    },
    {
      "id": "NAV002",
      "name": "NCX and Navigation link Check",
      "target_path": "OEBPS",
      "enabled": true,
      "file_name_pattern": "toc.ncx",
      "category": "Navigation Check"
    },
    {
      "id": "NAV005",
      "name": "Page List Link Check",
      "target_path": "OEBPS",
      "enabled": true,
      "file_name_pattern": "nav.xhtml",
      "category": "Navigation Check"
    },
    {
      "id": "XHTML002",
      "name": "EPUB Type Semantics Check",
      "target_path": "OEBPS/Text",
      "file_name_pattern": "*.xhtml",
      "enabled": true,
      "rule_config": {
        "file_heuristics": [
          {
            "pattern": "titlepage",
            "expected_body": "frontmatter",
            "expected_tag": "section",
            "expected_epub_type": "titlepage"
          },
          {
            "pattern": "copyright",
            "expected_body": "frontmatter",
            "expected_tag": "section",
            "expected_epub_type": "copyright-page"
          },
          {
            "pattern": "preface",
            "expected_body": "frontmatter",
            "expected_tag": "section",
            "expected_epub_type": "preface",
            "expected_role": "doc-preface"
          },
          {
            "pattern": "nav.xhtml",
            "expected_body": "frontmatter",
            "expected_tag": "nav",
            "expected_epub_type": "toc"
          },
          {
            "pattern": "toc",
            "expected_body": "frontmatter",
            "expected_tag": "section",
            "expected_epub_type": "toc",
            "expected_role": "doc-toc"
          },
          {
            "pattern": "contents",
            "expected_body": "frontmatter",
            "expected_tag": "section",
            "expected_epub_type": "toc",
            "expected_role": "doc-toc"
          },
          {
            "patterns": [
              "chapter",
              "ch"
            ],
            "expected_body": "bodymatter",
            "expected_tag": "section",
            "expected_epub_type": "chapter",
            "expected_role": "doc-chapter"
          },
          {
            "pattern": "appendix",
            "expected_body": "backmatter",
            "expected_tag": "section",
            "expected_epub_type": "appendix"
          },
          {
            "pattern": "glossary",
            "expected_body": "backmatter",
            "expected_tag": "section",
            "expected_epub_type": "glossary"
          },
          {
            "pattern": "index",
            "expected_body": "backmatter",
            "expected_tag": "section",
            "expected_epub_type": "index"
          }
        ],
        "global_pairings": [
          {
            "epub_type": "chapter",
            "required_role": "doc-chapter"
          },
          {
            "epub_type": "preface",
            "required_role": "doc-preface"
          },
          {
            "epub_type": "toc",
            "required_role": "doc-toc",
            "tag": "section"
          }
        ]
      },
      "category": "XHTML Check"
    },
    {
      "id": "XHTML003",
      "name": "Declare language on all content pages",
      "target_path": "OEBPS/Text",
      "file_name_pattern": "*.xhtml",
      "enabled": true,
      "rule_config": {
        "expected_lang": "en"
      },
      "category": "XHTML Check"
    },
    {
      "id": "XHTML004",
      "name": "<title> element is unique per page",
      "scope": "book",
      "enabled": true,
      "category": "XHTML Check"
    },
    {
      "id": "XHTML005",
      "name": "No <br/> allowed inside headings",
      "target_path": "OEBPS/Text",

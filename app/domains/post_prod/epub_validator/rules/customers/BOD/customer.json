{
  "rules": [
    {
      "id": "STRUCT001",
      "name": "EPUB Folder Structure Check",
      "scope": "book",
      "enabled": true,
      "category": "Structure Check"
    },
    {
      "id": "STRUCT002",
      "name": "Container File Check",
      "scope": "book",
      "enabled": true,
      "category": "Structure Check"
    },
    {
      "id": "STRUCT003",
      "name": "EPUB Content Folder Check",
      "scope": "book",
      "rule_config": {
        "opf_name": "isbn",
        "css_folder": "css",
        "css_file": "stylesheet.css",
        "xhtml_folder": "xhtml",
        "images_folder": "images",
        "nav_file": "nav.xhtml",
        "toc_file": "toc.ncx"
      },
      "enabled": true,
      "category": "Structure Check"
    },
    {
      "id": "STRUCT004",
      "name": "EPUB File Extension Check",
      "scope": "book",
      "enabled": true,
      "category": "Structure Check"
    },
    {
      "id": "XHTML001",
      "name": "XHTML Syntax Check",
      "target_path": "OEBPS/xhtml",
      "file_name_pattern": "*.xhtml",
      "enabled": true,
      "category": "XHTML Check"
    },
    {
      "id": "BOD-XHTML-001",
      "name": "Individual HTML files within the E-Book must be smaller than 30 MB",
      "target_path": "OEBPS/xhtml",
      "file_name_pattern": "*.xhtml",
      "enabled": true,
      "rule_config": {
        "max_file_size_mb": 30
      },
      "category": "XHTML Check"
    },
    {
      "id": "BOD-ENC-001",
      "name": "Files must be UTF-8 encoded and use direct Unicode characters instead of entities (only &amp; and &lt; allowed)",
      "target_path": "OEBPS",
      "file_name_pattern": [
        "*.xhtml",
        "*.ncx"
      ],
      "enabled": true,
      "category": "Encoding Check"
    },
    {
      "id": "CSS002",
      "name": "CSS File Validation",
      "target_path": "OEBPS/css",
      "enabled": true,
      "file_name_pattern": "*.css",
      "category": "CSS Check"
    },
    {
      "id": "URL001",
      "name": "Internal Link Check",
      "target_path": "OEBPS/xhtml",
      "enabled": true,
      "file_name_pattern": "*.xhtml",
      "category": "Link Check"
    },
    {
      "id": "URL002",
      "name": "External Link Check",
      "target_path": "OEBPS/xhtml",
      "enabled": true,
      "file_name_pattern": "*.xhtml",
      "category": "Link Check"
    },
    {
      "id": "URL003",
      "name": "URL Text Match Check",
      "target_path": "OEBPS/xhtml",
      "enabled": true,
      "file_name_pattern": "*.xhtml",
      "category": "Link Check"
    },
    {
      "id": "URL006",
      "name": "Plain text URLs must be wrapped in an <a> tag",
      "target_path": "OEBPS/xhtml",
      "file_name_pattern": "*.xhtml",
      "enabled": true,
      "category": "Link Check"
    },
    {
      "id": "BOD-COV-001",
      "name": "The cover image must be the jpg file",
      "target_path": "OEBPS/images",
      "file_name_pattern": "cover.*",
      "enabled": true,
      "rule_config": {
        "allowed_extensions": [
          "jpg"
        ]
      },
      "category": "Image Check"
    },
    {
      "id": "BOD-COV-002",
      "name": "Cover file must be the first item in the EPUB reading order (spine)",
      "target_path": "OEBPS",
      "file_name_pattern": "*.opf",
      "enabled": true,
      "category": "Image Check"
    },
    {
      "id": "BOD-COV-003",
      "name": "Cover image is exactly 300 DPI",
      "target_path": "OEBPS/images",
      "file_name_pattern": "cover.*",
      "enabled": true,
      "rule_config": {
        "expected_dpi": 300
      },
      "category": "Image Check"
    },
    {
      "id": "BOD-COV-004",
      "name": "Cover shortest axis must be at least 1400 pixels",
      "target_path": "OEBPS/images",
      "file_name_pattern": "cover.*",
      "enabled": true,
      "rule_config": {
        "min_shortest_axis": 1400
      },
      "category": "Image Check"
    },
    {
      "id": "BOD-COV-005",
      "name": "Cover must not exceed 3.2M pixels",
      "target_path": "OEBPS/images",
      "file_name_pattern": "cover.*",
      "enabled": true,
      "rule_config": {
        "max_total_pixels": 3200000
      },
      "category": "Image Check"
    },
    {
      "id": "BOD-COV-006",
      "name": "Cover must not exceed 5 MB file size",
      "target_path": "OEBPS/images",
      "file_name_pattern": "cover.*",
      "enabled": true,
      "rule_config": {
        "max_file_size_mb": 5
      },
      "category": "Image Check"
    },
    {
      "id": "BOD-COV-007",
      "name": "Cover image must have a default alt attribute",
      "target_path": "OEBPS/xhtml",
      "file_name_pattern": "*cover*.xhtml",
      "enabled": true,
      "rule_config": {
        "expected_alt_by_language": {
          "de": "Coverabbildung des Buches “{title}”",
          "en": "Cover image of the book “{title}”",
          "da": "Forsidebillede af bogen “{title}”",
          "fi": "Kirjan “{title}”",
          "fr": "Image de couverture du livre “{title}”",
          "sv": "Omslagsbild av boken “{title}”",
          "no": "Forsidebilde av boken “{title}”",
          "es": "Imagen de portada del libro “{title}”",
          "it": "Immagine di copertina del libro “{title}”",
          "pt": "Imagem da capa do livro “{title}”",
          "nl": "Coverafbeelding van het boek “{title}”",
          "ca": "Imatge de la coberta del llibre “{title}”",
          "va": "Imatge de la coberta del llibre “{title}”"
        }
      },
      "category": "Image Check"
    },
    {
      "id": "BOD-COV-008",
      "name": "Cover file declared in OPF metadata (<meta name='cover' content='cover-image' />)",
      "target_path": "OEBPS",
      "file_name_pattern": "*.opf",
      "enabled": true,
      "category": "Image Check"
    },
    {
      "id": "BOD-AUT-001",
      "name": "Author photo must have a default alt attribute",
      "target_path": "OEBPS/xhtml",
      "file_name_pattern": [
        "*about*author*.xhtml",
        "*About*Author*.xhtml",
        "*uber*die*autor*.xhtml",
        "*ber*die*autor*.xhtml",
        "*ber*den*autor*.xhtml",
        "*Die*Autoren*.xhtml",
        "*die*autoren*.xhtml",
        "*author*.xhtml",
        "*Author*.xhtml",
        "*autor*.xhtml",
        "*Autor*.xhtml"
      ],
      "enabled": true,
      "rule_config": {
        "expected_alt_by_language": {
          "de": "Portraitfoto von “{author}”",
          "da": "Portrætbillede af “{author}”",
          "fi": "kansikuva Kirjailijakuva “{author}”",
          "fr": "Photo de l‘auteur “{author}”",
          "sv": "Porträttfoto av “{author}”",
          "no": "Portrettbilde av “{author}”",
          "es": "Foto del autor “{author}”",
          "en": "Portrait photo of “{author}”",
          "it": "Foto ritratto di “{author}”",
          "pt": "Fotografia de retrato de “{author}”",
          "nl": "Portretfoto van “{author}”",
          "ca": "Fotografia de retrat de “{author}”",
          "va": "Fotografia de retrat de “{author}”"
        }
      },
      "category": "Image Check"
    },
    {
      "id": "BOD-IMG-001",
      "name": "All body images must be exactly 300 DPI",
      "target_path": "OEBPS/images",
      "file_name_pattern": "*.jpg",
      "enabled": true,
      "rule_config": {
        "expected_dpi": 300,
        "exclude_files": [
          "cover.jpg"
        ]
      },
      "category": "Image Check"
    },
    {
      "id": "BOD-IMG-002",
      "name": "Images inside the E-Book must have a minimum of 850 pixels in width or height, and max 5.6M pixels",
      "target_path": "OEBPS/images",
      "file_name_pattern": "*.jpg",
      "enabled": true,
      "rule_config": {
        "min_dimension": 850,
        "max_pixels": 5600000,
        "exclude_files": [
          "cover.jpg"
        ]
      },
      "category": "Image Check"
    },
    {
      "id": "BOD-IMG-003",
      "name": "<img> alt attribute must not be empty",
      "target_path": "OEBPS/xhtml",
      "file_name_pattern": "*.xhtml",
      "enabled": true,
      "category": "Image Check"
    },
    {
      "id": "BOD-IMG-004",
      "name": "Images and captions have to be contained inside a <figure> element",
      "target_path": "OEBPS/xhtml",
      "file_name_pattern": "*.xhtml",
      "enabled": true,
      "category": "Image Check"
    },
    {
      "id": "COM-LINK-001",
      "name": "citations must be linked to the corresponding block",
      "target_path": "OEBPS/xhtml",
      "file_name_pattern": [
        "*_[cC]hapter*.xhtml",
        "*_[cC]hap*.xhtml",
        "*_[cC]h*.xhtml",
        "*[cC]hapter*.xhtml",
        "*[cC]hap*.xhtml",
        "*[cC]h[0-9]*.xhtml"
      ],
      "include_mapped_chapters": true,
      "enabled": true,
      "rule_config": {
        "citation_regex": "\\b(?:see\\s+)?(?:(?:pages?|pp\\.|p\\.)(?![a-zA-Z])[ \\t\\-]*(\\d{1,4})(?:[ \\t]*[\\-–][ \\t]*\\d{1,4})?|(?:chapter|chap\\.|ch\\.)(?![a-zA-Z])[ \\t\\-]*(\\d+(?:[.\\-–][a-zA-Z0-9]+)*[a-zA-Z]?|(?!(?:did|mix|civil|mid|mild|vivid|dim|ill|mill|lid|dill|div|vic|doc)\\b)[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z])|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty|thirty|forty|fifty)(?:[ \\t]*[\\-–][ \\t]*\\d+(?:[a-zA-Z]?\\.?\\d+)*(?:\\.\\w+)*)?|(?:figure|fig\\.)(?![a-zA-Z])[ \\t\\-]*(\\d+(?:[.\\-–][a-zA-Z0-9]+)*[a-zA-Z]?|(?!(?:did|mix|civil|mid|mild|vivid|dim|ill|mill|lid|dill|div|vic|doc)\\b)[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z])|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty|thirty|forty|fifty)|(?:table|tbl\\.)(?![a-zA-Z])[ \\t\\-]*(\\d+(?:[.\\-–][a-zA-Z0-9]+)*[a-zA-Z]?|(?!(?:did|mix|civil|mid|mild|vivid|dim|ill|mill|lid|dill|div|vic|doc)\\b)[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z])|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty|thirty|forty|fifty)|(?:exhibit|exh\\.)(?![a-zA-Z])[ \\t\\-]*(\\d+(?:[.\\-–][a-zA-Z0-9]+)*[a-zA-Z]?|(?!(?:did|mix|civil|mid|mild|vivid|dim|ill|mill|lid|dill|div|vic|doc)\\b)[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z])|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty|thirty|forty|fifty)|(?:plate|pl\\.)(?![a-zA-Z])[ \\t\\-]*(\\d+(?:[.\\-–][a-zA-Z0-9]+)*[a-zA-Z]?|(?!(?:did|mix|civil|mid|mild|vivid|dim|ill|mill|lid|dill|div|vic|doc)\\b)[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z])|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty|thirty|forty|fifty)|map(?![a-zA-Z])[ \\t\\-]*(\\d+(?:[.\\-–][a-zA-Z0-9]+)*[a-zA-Z]?|(?!(?:did|mix|civil|mid|mild|vivid|dim|ill|mill|lid|dill|div|vic|doc)\\b)[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z])|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty|thirty|forty|fifty)|box(?![a-zA-Z])[ \\t\\-]*(\\d+(?:[.\\-–][a-zA-Z0-9]+)*[a-zA-Z]?|(?!(?:did|mix|civil|mid|mild|vivid|dim|ill|mill|lid|dill|div|vic|doc)\\b)[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z])|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty|thirty|forty|fifty)|(?:section|sec\\.)(?![a-zA-Z])[ \\t\\-]*(\\d+(?:[.\\-–][a-zA-Z0-9]+)*[a-zA-Z]?|(?!(?:did|mix|civil|mid|mild|vivid|dim|ill|mill|lid|dill|div|vic|doc)\\b)[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z])|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty|thirty|forty|fifty)|(?:part|pt\\.)(?![a-zA-Z])[ \\t\\-]*(\\d+(?:[.\\-–][a-zA-Z0-9]+)*[a-zA-Z]?|(?!(?:did|mix|civil|mid|mild|vivid|dim|ill|mill|lid|dill|div|vic|doc)\\b)[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z])|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty|thirty|forty|fifty)|(?:appendix|app\\.)(?![a-zA-Z])[ \\t\\-]*([1-9]|10|[A-K]|one|two|three|four|five|six|seven|eight|nine|ten)|(?:illustration|illus\\.)(?![a-zA-Z])[ \\t\\-]*(\\d+(?:[.\\-–][a-zA-Z0-9]+)*[a-zA-Z]?|(?!(?:did|mix|civil|mid|mild|vivid|dim|ill|mill|lid|dill|div|vic|doc)\\b)[IVXLCDM]{2,}(?:\\.[A-Z0-9]+)*|[IVXLCDM](?:\\.[A-Z0-9]+)+|[A-Z](?![a-zA-Z])|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|four